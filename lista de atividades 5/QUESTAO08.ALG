Algoritmo "questao08"

Var
usuario, senha : caracter

Inicio
escreva ("Digite o nome de usuário: ")
leia (usuario)

escreva ("Digite a senha: ")
leia (senha)

se (usuario = "admin") e (senha = "1234") entao
escreval ("Acesso Permitido")
senao
escreval ("Acesso Negado")
fimse

Fimalgoritmo