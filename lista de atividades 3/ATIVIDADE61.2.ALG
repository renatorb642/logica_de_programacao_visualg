Algoritmo "Atividade61.2"
//61) Crie um programa que mostre na tela a seguinte contagem, usando a estrutura
//“faça enquanto”
//0 3 6 9 12 15 18 21 24 27 30 Acabou!

var
numero : inteiro
inicio
numero <- 0
enquanto (numero <= 30) faca
escreva (numero, " ")
numero <- numero + 3
fimenquanto

escreva ("Acabou!")

fimalgoritmo