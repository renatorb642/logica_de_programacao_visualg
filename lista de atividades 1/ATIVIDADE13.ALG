Algoritmo "atividade13"

Var
salario , novoSalario : real

Inicio
escreva ("Digite o salário atual do funcionário: R$")
   leia (salario)

novoSalario <- salario * 1.15
   escreval ("Salário antigo: R$", salario:1:2)
   escreva ("Novo salário com 15% de aumento: R$", novoSalario:1:2)

Fimalgoritmo