Algoritmo "atividade15"

var
   dias : inteiro
   salario : real

inicio
escreva ("Digite o número de dias trabalhados no mês: ")
   leia (dias)


salario <- dias * (8 * 25)
   escreval ("Cálculo salárial")
   escreval ("Dias trabalhados: ", dias)
   escreva ("Salário total a receber: R$", salario)

Fimalgoritmo