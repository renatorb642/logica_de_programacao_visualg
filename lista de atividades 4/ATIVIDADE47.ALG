Algoritmo "atividade47"
//Desenvolva um aplicativo que mostre na tela o resultado da expressão 500 +
//450 + 400 + 350 + 300 + ... + 50 + 0

Var
contador, soma : inteiro

Inicio
soma <- 0

para contador de 500 ate 0 passo - 50 faca
soma <- soma + contador
fimpara

escreva ("A soma entre 500 + 450 + 400 + 350 + 300 + 250 + 200 + 150 + 100 + 50 + 0 é igual a: ", soma)
Fimalgoritmo