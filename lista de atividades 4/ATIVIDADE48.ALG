Algoritmo "atividade48"
//Faça um programa que leia 7 números inteiros e no final mostre o somatório
//entre eles.

Var
umAsete, numero, soma : inteiro

Inicio
soma <- 0

para umAsete de 1 ate 7 faca
escreva ("Digite o", umAsete, "º número: ")
leia (numero)
soma <- soma + numero
fimpara

escreva ("A soma dos números é: ", soma)

Fimalgoritmo